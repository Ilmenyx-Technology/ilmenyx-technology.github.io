---
import '../styles/global.css';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Página não encontrada · Page not found — Ilmenyx Technology</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <main class="wrap" style="padding:120px 24px">
    <img src="/img/horizontal-fundo-escuro.svg" alt="Ilmenyx Technology" width="132" height="48" style="margin-bottom:48px" />
    <p class="eyebrow">404</p>
    <h1>Página não encontrada.</h1>
    <p class="lead">O endereço pode ter mudado. <a href="/">Voltar ao início</a>.</p>
    <div lang="en" style="margin-top:48px">
      <h2>Page not found.</h2>
      <p class="lead">The address may have changed. <a href="/en/">Go to the home page</a>.</p>
    </div>
  </main>
</body>
</html>
