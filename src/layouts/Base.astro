---
import '../styles/global.css';
import { t, paths, type Lang, type Page } from '../i18n/strings';

interface Props { lang: Lang; page: Page; title: string; description: string; }
const { lang, page, title, description } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const p = paths[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(paths[other][page], Astro.site);
const link = (target: string) => (target in p ? p[target as Page] : target);
const navItems: [Page, string][] = [['about', s.nav.about], ['projects', s.nav.projects], ['news', s.nav.news], ['support', s.nav.support], ['contact', s.nav.contact]];
const current = (key: Page) => key === page || (key === 'projects' && page === 'controller');
---
<!doctype html>
<html lang={s.htmlLang} data-t="a">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={lang === 'pt' ? 'pt-BR' : 'en'} href={canonical} />
  <link rel="alternate" hreflang={other === 'pt' ? 'pt-BR' : 'en'} href={altUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Ilmenyx Technology" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/img/compartilhar.png', Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#100E14" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#100E14" />
</head>
<body>
  <script is:inline>
    // Transition preview: ?t=a|b|c|atual picks a variant (kept while browsing); the chooser below switches live.
    (function () {
      var q = new URLSearchParams(location.search).get('t');
      try { if (q) localStorage.setItem('ilx-t', q); q = q || localStorage.getItem('ilx-t'); } catch (e) {}
      if (q) document.documentElement.dataset.t = q;
    })();
  </script>
  <a class="skip" href="#conteudo">{s.skip}</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={p.home} aria-label="Ilmenyx Technology"><img src="/img/horizontal-fundo-escuro.svg" alt="Ilmenyx Technology" width="138" height="50" /></a>
      <nav class="nav" aria-label={s.nav.main}>
        {navItems.map(([key, label]) => <a href={p[key]} aria-current={current(key) ? 'page' : undefined}>{label}</a>)}
        <a class="lang" href={paths[other][page]} hreflang={other === 'pt' ? 'pt-BR' : 'en'} lang={other === 'pt' ? 'pt-BR' : 'en'} aria-label={s.switchName}>{s.switchLabel}</a>
      </nav>
    </div>
  </header>
  <main id="conteudo">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/img/horizontal-fundo-escuro.svg" alt="Ilmenyx Technology" width="132" height="48" />
        <p>{s.footer.blurb}</p>
        <p class="tagline">{lang === 'pt' ? 'Estrutura para criar. Liberdade para explorar.' : 'Structure to create. Freedom to explore.'}</p>
      </div>
      {s.footer.cols.map((col) => (
        <nav aria-label={col.title}>
          <p class="foot-title">{col.title}</p>
          <ul>{col.links.map(([label, target]) => <li><a href={link(target)}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="wrap foot-bottom">
      <span>© {new Date().getFullYear()} Ilmenyx Technology</span>
      <span>{s.footer.privacy}</span>
    </div>
  </footer>
  <div class="t-chooser" aria-label="Escolher transição">
    <span>Transição</span>
    <button type="button" data-v="a">A · Lâmina</button><button type="button" data-v="b">B · Horizonte</button><button type="button" data-v="c">C · Arco</button><button type="button" data-v="atual">Atual</button>
  </div>
  <script>
    // Preview chooser (temporary, for picking the hero transition).
    const chooser = document.querySelector('.t-chooser');
    const mark = () => chooser?.querySelectorAll('button').forEach((b) => b.toggleAttribute('aria-pressed', b.dataset.v === document.documentElement.dataset.t));
    chooser?.addEventListener('click', (e) => {
      const v = (e.target as HTMLElement).dataset?.v; if (!v) return;
      document.documentElement.dataset.t = v; try { localStorage.setItem('ilx-t', v); } catch {}
      mark(); window.scrollTo({ top: 0 });
    });
    mark();
  </script>
  <script>
    // Sections ease in as they reach the screen; cards in a row follow one another. Nothing hides without JS
    // or for people who asked the system for less motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      const items = document.querySelectorAll<HTMLElement>('main .sec .sechead, main .sec h2, main .sec .lead, main .sec .card, main .sec .principle, main .sec .news-item, main .sec .quote, main .sec .steps, main .sec .timeline li, main .sec .story-text p, main .sec .gem-story img, main .join-box, main .gallery figure');
      const seen = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); seen.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
      items.forEach((el) => {
        const siblings = el.parentElement ? Array.from(el.parentElement.children) : [];
        el.style.setProperty('--d', `${Math.min(siblings.indexOf(el), 5) * 90}ms`);
        el.classList.add('rv');
        seen.observe(el);
      });
    }
  </script>
</body>
</html>
