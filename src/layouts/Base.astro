---
import '../styles/global.css';
import SiteHead from '../components/SiteHead.astro';
import SiteScripts from '../components/SiteScripts.astro';
import { t, paths, type Lang, type Page } from '../i18n/strings';

interface Props { lang: Lang; page: Page; title: string; description: string; }
const { lang, page, title, description } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'pt' ? 'en' : 'pt';
const p = paths[lang];
const link = (target: string) => (target in p ? p[target as Page] : target);
const navItems: [Page, string][] = [['about', s.nav.about], ['projects', s.nav.projects], ['games', s.nav.games], ['news', s.nav.news], ['support', s.nav.support], ['contact', s.nav.contact]];
const current = (key: Page) => key === page || (key === 'projects' && page === 'controller');
---
<!doctype html>
<html lang={s.htmlLang}>
<head>
  <SiteHead htmlLang={lang === 'pt' ? 'pt-BR' : 'en'} otherLang={other === 'pt' ? 'pt-BR' : 'en'} title={title} description={description} altPath={paths[other][page]} />
</head>
<body>
  <a class="skip" href="#conteudo">{s.skip}</a>
  <header class="top">
    <div class="wrap">
      <a class="brand" href={p.home} aria-label="Ilmenyx Technology"><img src="/img/horizontal-fundo-escuro.svg" alt="Ilmenyx Technology" width="138" height="50" /></a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label={lang === 'pt' ? 'Abrir menu' : 'Open menu'} data-open={lang === 'pt' ? 'Abrir menu' : 'Open menu'} data-close={lang === 'pt' ? 'Fechar menu' : 'Close menu'}><span></span><span></span><span></span></button>
      <nav class="nav" id="menu" aria-label={s.nav.main}>
        {navItems.map(([key, label]) => <a href={p[key]} aria-current={current(key) ? 'page' : undefined}>{label}</a>)}
        <a class="lang" href={paths[other][page]} hreflang={other === 'pt' ? 'pt-BR' : 'en'} lang={other === 'pt' ? 'pt-BR' : 'en'} aria-label={s.switchName}>{s.switchLabel}</a>
      </nav>
    </div>
  </header>
  <main id="conteudo">
    <slot />
  </main>
  <footer class="foot">
    <div class="wrap foot-grid">
      <div class="foot-brand">
        <img src="/img/horizontal-fundo-escuro.svg" alt="Ilmenyx Technology" width="132" height="48" />
        <p>{s.footer.blurb}</p>
        <p class="tagline">{lang === 'pt' ? 'Estrutura para criar. Liberdade para explorar.' : 'Structure to create. Freedom to explore.'}</p>
      </div>
      {s.footer.cols.map((col) => (
        <nav aria-label={col.title}>
          <p class="foot-title">{col.title}</p>
          <ul>{col.links.map(([label, target]) => <li><a href={link(target)}>{label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="wrap foot-bottom">
      <span>© {new Date().getFullYear()} Ilmenyx Technology</span>
      <span>{s.footer.privacy}</span>
    </div>
  </footer>
  <SiteScripts />
</body>
</html>
