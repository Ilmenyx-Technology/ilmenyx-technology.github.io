---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SupportBody from '../components/SupportBody.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const x = t[lang].support;
---
<Base lang={lang} page="support" title={x.meta.title} description={x.meta.description}>
  <PageHero label={x.label} title={x.title} lead={x.lead} />
  <SupportBody lang={lang} />
</Base>
