---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { t, type Lang, KOFI, PIX } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const x = t[lang].support;
---
<Base lang={lang} page="support" title={x.meta.title} description={x.meta.description}>
  <PageHero label={x.label} title={x.title} lead={x.lead} />
  <section class="sec">
    <div class="wrap">
      <SectionHead label={x.donateHead.label} hint={x.donateHead.hint} />
      <div class="grid2">
        <div class="card">
          <h3>{x.kofi.title}</h3>
          <p class="muted">{x.kofi.text}</p>
          <a class="btn primary" href={KOFI}>{x.kofi.cta}</a>
          <p class="muted" style="margin-top:20px">{x.sponsors}</p>
        </div>
        <div class="card support">
          <img class="qr" src="/img/pix-qrcode.png" alt={x.pix.qrAlt} width="168" height="168" />
          <div><h3>{x.pix.title}</h3><p class="muted">{x.pix.text}</p><code style="word-break:break-all">{PIX}</code></div>
        </div>
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <SectionHead label={x.helpHead.label} hint={x.helpHead.hint} />
      <div class="grid3">{x.help.map((h) => <div class="card"><h3>{h.title}</h3><p class="muted">{h.text}</p><a class="arrow" href={h.href}>{h.cta} →</a></div>)}</div>
    </div>
  </section>
</Base>
