---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactBody from '../components/ContactBody.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const x = t[lang].contact;
---
<Base lang={lang} page="contact" title={x.meta.title} description={x.meta.description}>
  <PageHero label={x.label} title={x.title} lead={x.lead} />
  <ContactBody lang={lang} />
</Base>
