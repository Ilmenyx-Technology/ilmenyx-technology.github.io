---
import Base from '../layouts/Base.astro';
import HeroCrystal from '../components/HeroCrystal.astro';
import SectionHead from '../components/SectionHead.astro';
import ProjectCards from '../components/ProjectCards.astro';
import NewsList from '../components/NewsList.astro';
import { t, paths, type Lang, ISSUES, UNTESTED } from '../i18n/strings';
import { content } from '../i18n/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t[lang];
const h = s.home;
const c = content[lang];
const p = paths[lang];
---
<Base lang={lang} page="home" title={h.meta.title} description={h.meta.description}>
  <HeroCrystal lang={lang} title={h.hero.title} lead={h.hero.lead}
    primary={{ label: h.hero.primary, href: p.projects }} secondary={{ label: h.hero.secondary, href: p.about }} />

  <section class="sec">
    <div class="wrap">
      <SectionHead label={h.projects.label} hint={h.projects.hint} />
      <div class="sec-intro"><h2>{h.projects.title}</h2><p class="lead">{h.projects.lead}</p></div>
      <ProjectCards lang={lang} />
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.home.why.label} hint={c.home.why.hint} />
      <h2>{c.home.why.title}</h2>
      <div class="why">
        {c.why.map((x, i) => (
          <div class="principle" style={`--c:${x.color}`}>
            <span class="principle-n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="principle-gem" aria-hidden="true"></span>
            <h3>{x.title}</h3><p>{x.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.home.tested.label} hint={c.home.tested.hint} />
      <div class="sec-intro"><h2>{c.home.tested.title}</h2><p class="lead">{c.home.tested.lead}</p></div>
      <div class="grid3">
        {c.hardware.map((m) => (
          <div class="card machine">
            <span class="machine-ok mono">✓ OK</span>
            <h3>{m.name}</h3>
            <p class="machine-spec">{m.spec}</p>
            <p class="muted mono machine-os">{m.os}</p>
          </div>
        ))}
      </div>
      <p class="muted" style="margin-top:20px">{c.vms}</p>
      <a class="arrow" href={UNTESTED}>{c.home.tested.cta} →</a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.home.news.label} hint={c.home.news.hint} />
      <h2>{c.home.news.title}</h2>
      <NewsList items={c.news.slice(0, 3)} />
      <a class="arrow" href={p.news}>{c.home.news.all} →</a>
    </div>
  </section>

  <section class="sec">
    <div class="wrap brand-teaser">
      <div>
        <SectionHead label={c.home.author.label} hint={c.home.author.hint} />
        <blockquote class="quote">“{c.home.author.quote}”</blockquote>
        <p class="author"><strong>{c.home.author.name}</strong> · <span class="muted">{c.home.author.role}</span></p>
        <a class="arrow" href={p.about}>{c.home.author.more} →</a>
      </div>
      <div class="steps" aria-hidden="true">{[3, 5, 7, 9, 7, 5, 3].map((n, i) => <span style={`--h:${n * 10}%;--i:${i}`}></span>)}</div>
    </div>
  </section>

  <section class="sec join">
    <div class="wrap join-box">
      <h2>{h.join.title}</h2>
      <p class="lead">{h.join.text}</p>
      <div class="btns" style="justify-content:center">
        <a class="btn primary" href={ISSUES}>{h.join.primary}</a>
        <a class="btn" href={p.support}>{h.join.secondary}</a>
      </div>
    </div>
  </section>
</Base>
