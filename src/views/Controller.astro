---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import { t, type Lang, REPO, RELEASES, APPIMAGE_URL, APPIMAGE_CMD, FLATPAK_CMD } from '../i18n/strings';
import { content } from '../i18n/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t[lang];
const c = s.controller;
const hist = content[lang];
---
<Base lang={lang} page="controller" title={c.meta.title} description={c.meta.description}>
  <PageHero label={c.label} title={c.title} lead={c.lead}>
    <div class="btns">
      <a class="btn primary" href={APPIMAGE_URL}>{c.download}</a>
      <a class="btn" href="#baixar">{c.flatpakJump}</a>
      <a class="btn" href={REPO}>{c.github}</a>
    </div>
    <p class="muted note">{c.note}</p>
    <img class="hero-shot" src={`${s.shotDir}visao-geral.png`} alt={s.projectsList.controller.shotAlt} width="1279" height="774" />
  </PageHero>
  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.featuresHead.label} hint={c.featuresHead.hint} />
      <div class="grid3">{c.features.map(([title, text], i) => <div class="card feature"><span class="mono feature-n">{String(i + 1).padStart(2, '0')}</span><h3>{title}</h3><p class="muted">{text}</p></div>)}</div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.galleryHead.label} hint={c.galleryHead.hint} />
      <div class="gallery">{c.shots.map(([file, alt]) => <figure><img src={`${s.shotDir}${file}`} alt={alt} width="1279" height="774" loading="lazy" /><figcaption>{alt}</figcaption></figure>)}</div>
    </div>
  </section>
  <section class="sec" id="baixar">
    <div class="wrap">
      <SectionHead label={c.downloadHead.label} hint={c.downloadHead.hint} />
      <div class="grid2">
        <div class="card dl">
          <div class="tags"><span class="tag tag-live">{c.appimage.badge}</span></div>
          <h3>{c.appimage.title}</h3>
          <p class="muted">{c.appimage.text}</p>
          <div class="cmd"><code>{APPIMAGE_CMD}</code><button type="button" class="copy" data-copy={APPIMAGE_CMD} data-done={c.copied}>{c.copy}</button></div>
          <a class="btn primary" href={APPIMAGE_URL}>{c.appimage.cta}</a>
        </div>
        <div class="card dl">
          <h3>{c.flatpak.title}</h3>
          <p class="muted">{c.flatpak.text}</p>
          <div class="cmd"><code>{FLATPAK_CMD}</code><button type="button" class="copy" data-copy={FLATPAK_CMD} data-done={c.copied}>{c.copy}</button></div>
        </div>
      </div>
      <a class="arrow" href={RELEASES} style="margin-top:20px">{c.others} →</a>
      <p class="muted" style="margin-top:20px">{c.verify} <code>3D97 1657 2A39 8DCD D0CF F0EE 733D 2EC7 8436 DCE8</code></p>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <SectionHead label={c.promisesHead.label} hint={c.promisesHead.hint} />
      <div class="grid2">
        <ul class="feature-list">{c.promises.map((x) => <li>{x}</li>)}</ul>
        <p class="muted">{c.license}</p>
      </div>
    </div>
  </section>
  <section class="sec">
    <div class="wrap">
      <SectionHead label={hist.history.label} hint={hist.history.hint} />
      <h2>{hist.history.title}</h2>
      <ol class="timeline">{hist.events.map((e) => <li><span class="mono tl-date">{e.date}</span><h3>{e.title}</h3><p class="muted">{e.text}</p></li>)}</ol>
    </div>
  </section>
  <script>
    // Copy buttons for the terminal commands (no tracking, nothing sent anywhere).
    document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((b) => {
      const label = b.textContent;
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = b.dataset.done ?? label; setTimeout(() => (b.textContent = label), 1800); } catch { /* clipboard blocked: the command stays selectable */ }
      });
    });
  </script>
</Base>
