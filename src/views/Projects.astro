---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProjectCards from '../components/ProjectCards.astro';
import { t, type Lang } from '../i18n/strings';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const x = t[lang].projectsPage;
---
<Base lang={lang} page="projects" title={x.meta.title} description={x.meta.description}>
  <PageHero label={x.label} title={x.title} lead={x.lead} />
  <section class="sec" style="padding-top:24px"><div class="wrap"><ProjectCards lang={lang} /></div></section>
</Base>
