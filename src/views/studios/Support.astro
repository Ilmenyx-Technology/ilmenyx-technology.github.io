---
import StudiosBase from '../../layouts/StudiosBase.astro';
import PageHero from '../../components/PageHero.astro';
import SupportBody from '../../components/SupportBody.astro';
import { t, type Lang } from '../../i18n/strings';
import { st } from '../../i18n/studios';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const x = t[lang].support;
const meta = st[lang].support.meta;
---
<StudiosBase lang={lang} page="support" title={meta.title} description={meta.description}>
  <PageHero label={x.label} title={x.title} lead={x.lead} />
  <SupportBody lang={lang} />
</StudiosBase>
