---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import NewsList from '../components/NewsList.astro';
import { type Lang, RELEASES } from '../i18n/strings';
import { content } from '../i18n/content';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const c = content[lang];
---
<Base lang={lang} page="news" title={c.newsPage.meta.title} description={c.newsPage.meta.description}>
  <PageHero label={c.newsPage.label} title={c.newsPage.title} lead={c.newsPage.lead} />
  <section class="sec" style="padding-top:24px">
    <div class="wrap">
      <NewsList items={c.news} />
      <a class="arrow" href={RELEASES}>{c.newsPage.releases} →</a>
    </div>
  </section>
</Base>
