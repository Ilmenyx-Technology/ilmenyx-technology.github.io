---
import type { NewsItem } from '../i18n/content';
interface Props { items: NewsItem[]; }
const { items } = Astro.props;
---
<ol class="news">
  {items.map((n) => (
    <li class="news-item">
      <div class="news-meta"><span class="mono">{n.date}</span><span class="tag">{n.tag}</span></div>
      <div><h3>{n.title}</h3><p class="muted">{n.text}</p></div>
    </li>
  ))}
</ol>
