---
import Base from '../layouts/Base.astro';
import { t, type Lang, REPO, RELEASES } from '../i18n/strings';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t[lang];
const c = s.ctrl;
---
<Base lang={lang} title={c.meta.title} description={c.meta.description} alternate={s.other.controller}>
  <section class="hero">
    <div class="wrap" style="grid-template-columns:1fr">
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h1>{c.title}</h1>
        <p class="lead">{c.lead}</p>
        <div class="btns">
          <a class="btn primary" href={RELEASES}>{c.download}</a>
          <a class="btn" href={REPO}>{c.github}</a>
        </div>
        <p class="muted" style="margin-top:18px;max-width:720px">{c.note}</p>
        <img class="shot" src={`${s.shotDir}visao-geral.png`} alt={s.products.controller.shotAlt} width="1279" height="774" style="margin-top:40px;border-radius:var(--r-lg);border:1px solid var(--line);box-shadow:0 30px 80px rgba(0,0,0,.45)" />
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{c.featuresTitle}</h2>
      <div class="grid3" style="margin-top:32px">
        {c.features.map(([title, text]) => (
          <div class="card"><h3>{title}</h3><p class="muted">{text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{c.galleryTitle}</h2>
      <div class="gallery">
        {c.shots.map(([file, alt]) => <img src={`${s.shotDir}${file}`} alt={alt} width="1279" height="774" loading="lazy" />)}
      </div>
    </div>
  </section>

  <section id="baixar">
    <div class="wrap">
      <h2>{c.downloadTitle}</h2>
      <div class="card" style="margin-top:28px;overflow-x:auto">
        <table>
          <thead><tr><th scope="col">{c.table.file}</th><th scope="col">{c.table.for}</th></tr></thead>
          <tbody>{c.files.map(([file, text]) => <tr><td><strong>{file}</strong></td><td class="muted">{text}</td></tr>)}</tbody>
        </table>
      </div>
      <div class="btns"><a class="btn primary" href={RELEASES}>{c.download}</a></div>
      <p class="muted" style="margin-top:20px">{c.verify} <code>3D97 1657 2A39 8DCD D0CF F0EE 733D 2EC7 8436 DCE8</code></p>
    </div>
  </section>

  <section>
    <div class="wrap grid2">
      <div>
        <h2>{c.principlesTitle}</h2>
        <ul class="feature-list" style="margin-top:24px">{c.principles.map((p) => <li>{p}</li>)}</ul>
      </div>
      <div>
        <h2>{c.licenseTitle}</h2>
        <p class="muted" style="margin-top:24px">{c.license}</p>
      </div>
    </div>
  </section>
</Base>
