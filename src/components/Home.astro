---
import Base from '../layouts/Base.astro';
import { t, type Lang, REPO, RELEASES, ORG, KOFI, EMAIL, PIX } from '../i18n/strings';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t[lang];
---
<Base lang={lang} title={s.meta.title} description={s.meta.description} alternate={s.other.href}>
  <section class="hero">
    <div class="wrap">
      <div>
        <p class="eyebrow">01 / {s.hero.eyebrow}</p>
        <h1>{s.hero.title}</h1>
        <p class="lead">{s.hero.lead}</p>
        <div class="btns">
          <a class="btn primary" href={s.controllerPage}>{s.hero.cta}</a>
          <a class="btn" href={ORG}>{s.hero.cta2}</a>
        </div>
      </div>
      <img class="gem" src="/img/gema-lapidada.svg" alt={s.hero.gemAlt} width="420" height="420" />
    </div>
  </section>

  <section id="marca">
    <div class="wrap">
      <p class="eyebrow">{s.brand.eyebrow}</p>
      <h2>{s.brand.title}</h2>
      <p class="lead">{s.brand.lead}</p>
      <div class="grid3" style="margin-top:40px">
        {s.brand.cards.map((c) => (
          <div class="card"><h3>{c.title}</h3><p class="muted">{c.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="produtos">
    <div class="wrap">
      <p class="eyebrow">{s.products.eyebrow}</p>
      <h2>{s.products.title}</h2>
      <div class="card product" style="margin-top:32px">
        <div>
          <span class="badge">{s.products.controller.badge}</span>
          <h3 style="font-size:30px">{s.products.controller.name}</h3>
          <p class="muted">{s.products.controller.text}</p>
          <div class="btns">
            <a class="btn primary" href={s.controllerPage}>{s.products.controller.more}</a>
            <a class="btn" href={RELEASES}>{s.products.controller.download}</a>
          </div>
        </div>
        <img class="shot" src={`${s.shotDir}visao-geral.png`} alt={s.products.controller.shotAlt} width="1279" height="774" loading="lazy" />
      </div>
      <div class="card soon" style="margin-top:20px">
        <h3>{s.products.soon.title}</h3>
        <p class="muted">{s.products.soon.text} <a href={ORG}>github.com/Ilmenyx-Technology</a></p>
      </div>
    </div>
  </section>

  <section id="principios">
    <div class="wrap">
      <p class="eyebrow">{s.principles.eyebrow}</p>
      <h2>{s.principles.title}</h2>
      <div class="principles" style="margin-top:36px">
        {s.principles.items.map((p) => (
          <div class="principle" style={`border-color:${p.color}`}><h3>{p.title}</h3><p>{p.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section id="apoie">
    <div class="wrap">
      <p class="eyebrow">{s.support.eyebrow}</p>
      <h2>{s.support.title}</h2>
      <p class="lead">{s.support.text}</p>
      <div class="grid2" style="margin-top:32px">
        <div class="card">
          <h3>Ko-fi</h3>
          <p class="muted">{lang === 'pt' ? 'Cartão ou PayPal, de qualquer país.' : 'Card or PayPal, from any country.'}</p>
          <a class="btn primary" href={KOFI}>{s.support.kofi}</a>
          <p class="muted" style="margin-top:20px">{s.support.sponsors}</p>
        </div>
        <div class="card support">
          <img class="qr" src="/img/pix-qrcode.png" alt={s.support.qrAlt} width="168" height="168" loading="lazy" />
          <div>
            <h3>Pix</h3>
            <p class="muted">{s.support.pixLabel}</p>
            <code style="word-break:break-all">{PIX}</code>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contato">
    <div class="wrap">
      <p class="eyebrow">{s.contact.eyebrow}</p>
      <h2>{s.contact.title}</h2>
      <p class="lead">{s.contact.text}</p>
      <div class="btns">
        <a class="btn primary" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="btn" href={`${REPO}/issues/new/choose`}>{s.contact.issues}</a>
      </div>
      <p class="muted" style="margin-top:20px">{s.contact.security}</p>
    </div>
  </section>
</Base>
